{
  "name": "obsidian-html-preview",
  "version": "0.3.0",
  "description": "Preview and non-destructively clean up HTML files in Obsidian.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-release.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run validate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
